VITE_API_BASE_URL=https://be-investjo.smartdots.net/api

# Optional: endpoints (keep them relative to VITE_API_BASE_URL)
VITE_API_REGISTER_ENDPOINT=/register
VITE_API_HOME_ENDPOINT=/home
VITE_API_ABOUT_ENDPOINT=/about
VITE_API_AGENDA_ENDPOINT=/agendas
VITE_API_SPEAKERS_ENDPOINT=/speakers
VITE_API_TOURISM_ENDPOINT=/tourism
VITE_API_PARTNERS_ENDPOINT=/partners
VITE_API_NEWS_ENDPOINT=/news-updates
VITE_API_OPPORTUNITIES_ENDPOINT=/investment-opportunities
VITE_API_OPPORTUNITY_DETAILS_ENDPOINT=/investment-opportunities/:id
VITE_API_CONTACT_ENDPOINT=/contact

# Optional timeout for API requests (milliseconds)
VITE_API_TIMEOUT_MS=60000
